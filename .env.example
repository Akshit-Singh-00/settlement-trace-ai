# Optional server-side Gemini explanation layer. The app uses deterministic copy without this key.
GEMINI_API_KEY=
# Optional model override. Keep unset to use gemini-2.5-flash-lite.
GEMINI_MODEL=

# Team workspace (server-only; never use NEXT_PUBLIC_ for these secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:4173
WORKSPACE_ADMIN_EMAIL=
# Only sk_test_ keys are accepted. No live payments are created.
STRIPE_SECRET_KEY=
# Required to authorize the daily Vercel job
CRON_SECRET=
# Optional operator-configured HTTPS endpoint; enable alerts in Administration
ALERT_WEBHOOK_URL=
